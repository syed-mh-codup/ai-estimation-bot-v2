# ─────────────────────────────────────────────────────────────────────────────
# Environment template. Copy the relevant sections into the TWO files the app
# actually reads (neither Next.js nor Prisma auto-loads this root file):
#
#   1. packages/db/.env       — Prisma CLI (migrate/generate) + `pnpm db:seed`
#   2. apps/web/.env.local    — Next.js dev server (auth + DB queries)
#
# DATABASE_URL must be set in BOTH. Both files are git-ignored, so secrets here
# never get committed. Ready-to-copy stubs live at:
#   packages/db/.env.example   apps/web/.env.example
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (needed in packages/db/.env AND apps/web/.env.local) ─────────────
# Local docker-compose default (postgres/postgres, host port 5433):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_estimation?schema=public"

# ── Auth — next-auth v5 (apps/web/.env.local) ────────────────────────────────
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=""
# Legacy v4 alias (kept for compatibility):
NEXTAUTH_SECRET=""
# AUTH_URL / NEXTAUTH_URL intentionally omitted: auth.config.ts uses
# trustHost:true, so the origin is derived per-request (works on any port).

# ── Agent run / integrations — NOT needed for the current UI flow ────────────
# Only required once the "Run estimate" pipeline (WS22-02) is wired up.
OPENROUTER_API_KEY=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_IMPERSONATE_SUBJECT=""   # Workspace user to impersonate; required for Sheets export (a service account owns no Drive quota)
ENCRYPTION_KEY=""

# ── Completion emails (optional) — SMTP, defaults tuned for Resend ───────────
# When unset, the app simply skips sending (logs and moves on).
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"          # Resend uses the literal "resend" as the username
SMTP_PASSWORD=""            # your Resend API key
EMAIL_FROM="AI Estimation <estimates@yourdomain.com>"
APP_URL="http://localhost:3000"   # origin used for links inside emails
