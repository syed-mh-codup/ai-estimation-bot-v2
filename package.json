{
  "name": "codup-ai-estimation-v2",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:inngest": "npx --yes inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "pnpm -r typecheck",
    "audit": "pnpm --filter @repo/audit audit",
    "audit:fields": "pnpm --filter @repo/audit audit:fields",
    "audit:exports": "pnpm --filter @repo/audit audit:exports",
    "db:seed": "pnpm --filter @repo/db db:seed && pnpm --filter @repo/db db:seed:presets && pnpm --filter @repo/db db:seed:taxonomy",
    "db:seed:admin": "pnpm --filter @repo/db db:seed:admin",
    "db:embed:presets": "pnpm --filter @repo/agents embed:presets",
    "db:setup": "pnpm --filter @repo/db exec prisma migrate deploy && pnpm run db:seed",
    "test:e2e:setup": "bash scripts/setup-test-db.sh",
    "test:e2e": "bash scripts/setup-test-db.sh && pnpm --filter web exec playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "knip": "6.32.2",
    "playwright": "^1.60.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
