{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc --noEmit",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "db:seed:admin": "tsx src/seed-admin.ts",
    "db:seed:presets": "tsx src/seed-presets.ts",
    "db:seed:taxonomy": "tsx src/seed-taxonomy.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@repo/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "xlsx": "^0.18.5"
  }
}
