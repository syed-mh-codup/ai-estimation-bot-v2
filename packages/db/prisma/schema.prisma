generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/client"
}

datasource db {
  provider   = "postgresql"
  // App connections use the (pooled) DATABASE_URL. Migrations need a DIRECT
  // (non-pooled) connection — on Neon the pooler can't run DDL/advisory locks.
  // Locally DIRECT_URL can equal DATABASE_URL.
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ESTIMATOR
}

enum ChangeMotivation {
  UPSKILL
  TECH_ADVANCEMENT
  NEW_PROCESS
  POST_DELIVERY_VALIDATION
  CORRECTION
  OTHER
}

enum DataVolume {
  NONE
  LOW
  HIGH
}

enum PresetPhase {
  FOUNDATION
  CORE
  ENHANCEMENT
}

enum Level {
  LOW
  MEDIUM
  HIGH
}

enum AgentKind {
  SUPERVISOR
  LIBRARIAN
  DETECTIVE
  ARCHIVIST
  SPECIALIST_DEV
  SPECIALIST_QA
  SPECIALIST_PM
  SPECIALIST_BA
  ARCHITECT
  /// Not part of a run. Oracle answers questions about one estimate on demand;
  /// it is an agent rather than an artifact type, which is why it belongs in
  /// this enum. See packages/db/src/agent-catalogue.ts for what each kind is.
  ORACLE
  /// Not part of a run either. Works out which of one estimate's cards depend
  /// on which, so the scope configurator has a graph to cascade over. On demand
  /// because it uses a heavy model and most estimates never need one. AEH-235.
  CARTOGRAPHER
}

/// The attribution vocabulary for ModelUsage rows. Owned in code by
/// packages/db/src/usage-catalogue.ts (USAGE_KINDS); the completeness test fails
/// when this and the catalogue drift. Agent-shaped values are the AgentKind
/// strings; INGEST and PRESET_EMBEDDING are model surfaces that are not agents.
enum UsageKind {
  SUPERVISOR
  LIBRARIAN
  DETECTIVE
  ARCHIVIST
  SPECIALIST_DEV
  SPECIALIST_QA
  SPECIALIST_PM
  SPECIALIST_BA
  ARCHITECT
  ORACLE
  CARTOGRAPHER
  /// Supporting-document generation. ONE value for every artifact type, and
  /// deliberately so: artifact types are rows in ArtifactType, so a per-type
  /// usage kind would be a migration per type — the exact thing AEH-239 exists
  /// to abolish. "Which artifact cost this" is answered by
  /// `ModelUsage.artifactId`, which is a join, not an enum value.
  ARTIFACT
  INGEST
  /// Preset-library embedding only. An Archivist query embed is recorded as
  /// ARCHIVIST, because "which agent is burning the money" is the question the
  /// kind exists to answer, and that spend is the Archivist's. So this value is
  /// deliberately narrow: it is the backfill sweep, not "all embedding spend" —
  /// that is a query on `model`, not on `kind`.
  PRESET_EMBEDDING
}

/// Who wrote an Oracle turn. Oracle has no tool calls and no system turns in the
/// transcript — the system prompt is the live PromptVersion, not a stored row —
/// so two values is the whole vocabulary.
enum OracleRole {
  USER
  ASSISTANT
}

enum EstimateStatus {
  DRAFT
  REVIEW
  FINALISED
}

/// Which beat of the deadline sequence a reminder was. Three beats, deliberately:
/// a heads-up, the day itself, and the miss. One EstimateReminder row per
/// (estimate, kind) is what stops a retried sweep from nagging twice.
enum ReminderKind {
  /// Three days out or fewer, and not yet the due day.
  DUE_SOON
  /// The due date is today.
  DUE_TODAY
  /// The due date has passed.
  OVERDUE
}

enum RunStatus {
  IDLE
  RUNNING
  DONE
  FAILED
}

enum RoleKind {
  DEV
  QA
  PM
  BA
}

/// What happened to a risk the Detective raised.
///
/// A column rather than a derived state, because the whole point of the feature
/// is being able to ask later: what did we spot, what did we cost, and what did
/// we knowingly walk away from. That is a query, not a reconstruction.
enum HiddenWorkOutcome {
  /// Detected, nobody has decided yet. This is what the finalise gate counts.
  OPEN
  /// Known flag, costed automatically by the Specialist council.
  AUTO_COST
  /// A person costed it into a card by hand.
  ACCEPTED
  /// A person said existing work already covers it.
  COVERED
  /// A person decided not to cost it, and said why.
  DISMISSED
}

/// Governance state of a taxonomy node. The taxonomy was originally derived
/// wholesale from the preset library with no authoring surface; once nodes can
/// be proposed by a run, "is this node real yet" has to be a queryable fact
/// rather than a convention. AEH-263.
enum TaxonomyStatus {
  /// Proposed by a run, not yet reviewed. Invisible to the Librarian.
  PROPOSED
  /// Accepted by an admin. This is the only status the Librarian classifies against.
  ACTIVE
  /// Folded into another node by an admin; collapsedIntoKey names the survivor.
  COLLAPSED
}

/// How a preset entered the library. Stored as a column, not inferred from the
/// code prefix — "show me everything validated against delivery" should be a
/// query, not a string match.
enum PresetOrigin {
  /// Imported from docs/Estimate Presets (ISM).xlsx.
  SEEDED
  /// Written back from a finalised estimate.
  FINALISED
  /// Entered by hand in the admin UI.
  MANUAL
}

// ─── Identity & Access ────────────────────────────────────────────────────────

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  hash              String
  name              String?
  role              Role            @default(ESTIMATOR)
  createdAt         DateTime        @default(now())
  /// When set, this account can no longer sign in AND its live sessions stop
  /// working. Blocking `authorize()` alone would only stop NEW logins — with
  /// `session: { strategy: 'jwt' }` there is no session table to revoke, so an
  /// already-signed-in user would keep working until their token expired. The
  /// DB-backed jwt callback (auth.ts) re-reads this every request, which is what
  /// actually ends a session.
  ///
  /// Disabling is the answer when ownership history should be preserved;
  /// delete-and-reassign is the answer when it shouldn't. Both exist.
  disabledAt        DateTime?
  /// Set when the password changes, so live sessions issued before that can be
  /// rejected by the same DB-backed jwt callback. Without it, changing a
  /// password does not sign other devices out.
  passwordChangedAt DateTime?
  estimates         Estimate[]      @relation("EstimateOwner")
  /// Estimates this user is answerable for, which is not the same set as the
  /// ones they created. See Estimate.custodianId.
  custodianOf       Estimate[]      @relation("EstimateCustodian")
  oracleThreads     OracleThread[]
  /// Configured scopes this user cut. Attribution, not ownership: a scenario is
  /// a record of a conversation somebody had.
  scopeScenarios    ScopeScenario[]
}

// ─── Taxonomy ─────────────────────────────────────────────────────────────────

model TaxonomyNode {
  id               String                @id @default(cuid())
  key              String                @unique
  label            String
  parentKey        String?
  /// Governance state. Only ACTIVE nodes reach the Librarian's classification
  /// vocabulary (run-estimate.ts loadTaxonomyEntries), so a PROPOSED node
  /// changes no estimate until an admin accepts it. That filter is what bounds
  /// the blast radius of adding nodes at all. AEH-263.
  status           TaxonomyStatus        @default(ACTIVE)
  /// Set when an admin collapses a proposal into an existing node instead of
  /// accepting it. Bare key like parentKey (no relation) — same idiom, and the
  /// admin action validates the target exists. Reads resolve through it.
  collapsedIntoKey String?
  /// May the Librarian assign this key to a SOW requirement?
  ///
  /// A different axis from `status`, and the distinction is load-bearing: status
  /// asks "is this node real", classifiable asks "can a client ask for it".
  /// `process.code-review` is real, referenceable and promotable, but nobody
  /// writes "do code reviews" in a statement of work — offering it to the
  /// Librarian only invites a real requirement to be misclassified as overhead.
  /// `infra.rate-limit` is the opposite: a client absolutely can ask for rate
  /// limiting, and when they do it is asked-for work under that key, which is
  /// also how the hidden-work audit sees it is already covered. AEH-263.
  classifiable     Boolean               @default(true)
  versions         TaxonomyNodeVersion[]
}

model TaxonomyNodeVersion {
  id               String           @id @default(cuid())
  nodeKey          String
  node             TaxonomyNode     @relation(fields: [nodeKey], references: [key])
  version          Int
  label            String
  reqType          String?
  keywords         String[]
  active           Boolean          @default(false)
  changeReason     String?
  changeMotivation ChangeMotivation @default(OTHER)
  createdAt        DateTime         @default(now())
  createdBy        String?

  @@unique([nodeKey, version])
}

// ─── Preset Library ───────────────────────────────────────────────────────────

model Preset {
  /// cuid. Opaque and never allocated by a human — see `code` for the readable
  /// handle. Load-bearing as an identity: MenuItem.sourcePresetId points at it,
  /// and PresetDependency uses it as the stable end of every edge.
  ///
  /// The xlsx-seeded ids (P01–P45) were retired with the spreadsheet in AEH-242;
  /// nothing should assume that range still exists. AEH-306 removes the last
  /// references to it from the agent prompts.
  id         String             @id @default(cuid())
  /// Readable handle — "P46". Unique, shown everywhere, never typed by a user:
  /// allocated from a Postgres sequence (see allocatePresetCode) so concurrent
  /// finalises can't collide the way max()+1 would.
  ///
  /// Numbers are free-flowing — no zero padding, no fixed width. Codes imported
  /// from the xlsx keep that file's own formatting (P01–P45) because people
  /// cross-reference the spreadsheet; allocated codes are plain (P46, P100).
  code       String?            @unique
  /// Where this preset came from. See PresetOrigin.
  origin     PresetOrigin       @default(MANUAL)
  versions   PresetVersion[]
  /// Edges pointing AT this preset — the versions that declare they need it.
  /// Read `dependentsOf` rather than walking this by hand; one hop is rarely
  /// the answer you want.
  dependents PresetDependency[]
}

model PresetVersion {
  id       String  @id @default(cuid())
  presetId String
  preset   Preset  @relation(fields: [presetId], references: [id])
  version  Int
  active   Boolean @default(false)

  /// The estimate anchor — one per version, carrying the hours, side flags and
  /// comparison signals a preset contributes to an estimate. AEH-244 split this
  /// out so the anchor can become a first-class costed-work record (AEH-243).
  anchor       PresetAnchor?
  /// The retrieval surface — one per version, self-contained: it holds every
  /// field the embedding is built from, so computing a row's own vector never
  /// requires a join to a sibling table.
  retrieval    PresetRetrieval?
  /// The composition rules — one per version, so `canParallel` keeps its own
  /// history exactly like the anchor and retrieval do.
  composition  PresetComposition?
  /// What this version says it needs before it can be delivered. AEH-242.
  dependencies PresetDependency[]

  changeReason     String?
  changeMotivation ChangeMotivation @default(OTHER)
  createdAt        DateTime         @default(now())
  createdBy        String?
  sourceEstimateId String?
  /// Which menu item of that estimate this version came from. Together with
  /// sourceEstimateId this is the idempotency key for promotion — re-finalising
  /// must not stack duplicate versions. It used to be implicit in a synthesised
  /// preset id (`promoted-<estimateId>-<itemId>`); now that ids are cuids the
  /// key has to be a real column.
  sourceMenuItemId String?

  @@unique([presetId, version])
}

/// What makes a preset findable — the retrieval surface for Archivist similarity
/// search. One row per version, mirroring the anchor's lifecycle, so a rename or
/// keyword edit is a new version with a real history rather than an in-place
/// overwrite. AEH-244.
///
/// Self-contained by construction: name, description, keywords, userStoryTags and
/// notes are the five fields `presetEmbeddingText` concatenates, and they all live
/// here — a retrieval row's embedding text is computable from the row alone.
model PresetRetrieval {
  id              String                       @id @default(cuid())
  presetVersionId String                       @unique
  presetVersion   PresetVersion                @relation(fields: [presetVersionId], references: [id])
  name            String
  description     String
  keywords        String[]
  /// B2B buyer | Dev ops | Marketing editor — feeds the embedding text.
  userStoryTags   String[]
  /// Key assumption; if violated -> change request. Also feeds the embedding
  /// text, because it carries retrieval-relevant meaning about what the preset
  /// actually assumes and excludes ("P21 order history API must be available").
  notes           String
  /// The exact text `embedding` was generated from. Present so staleness is
  /// decidable: an admin edit carries the old vector forward (never de-indexing
  /// the preset) and the backfill re-embeds any row whose current text no longer
  /// matches this. Null means "never embedded".
  embeddingText   String?
  /// pgvector embedding for Archivist similarity search
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

/// The estimate anchor — what a preset contributes to an estimate. One row per
/// version because the anchor changes with each version: a v2 may have different
/// hours or risk. Its own table and own ID so AEH-243 can decide whether this IS
/// the costed-work type or whether a separate CostedWork record references it.
/// AEH-244.
model PresetAnchor {
  id               String        @id @default(cuid())
  presetVersionId  String        @unique
  presetVersion    PresetVersion @relation(fields: [presetVersionId], references: [id])
  /// The preset's dev effort as ONE number. Frontend and backend are estimated
  /// together because delivery is full-stack — the split used to exist to
  /// allocate work across separate FE/BE resources, and that need is gone.
  devHours         Int
  /// Which sides of the stack this preset's work covers. Reference only: they
  /// describe `devHours`, they never divide it.
  touchesFrontend  Boolean       @default(false)
  touchesBackend   Boolean       @default(false)
  /// LEGACY, nullable, no longer written. The historical FE/BE split as recorded
  /// in the xlsx, retained because the decision to estimate as one figure may be
  /// revisited and this data can't be recovered. NULL means "not tracked".
  /// @backend-only Archived source data, kept because the xlsx FE/BE split cannot be reconstructed if the one-figure decision is ever revisited.
  beHours          Int?
  /// The frontend half of the same archived split; see beHours above.
  /// @backend-only Archived source data, kept because the xlsx FE/BE split cannot be reconstructed if the one-figure decision is ever revisited.
  feHours          Int?
  risk             Level
  aiAssist         Level
  dataVolume       DataVolume
  integrationCount Int
  projectSizeFit   String[]
  phase            PresetPhase
  spikeNeeded      Boolean
  category         String
  reqType          String
  platforms        String[]
  taxonomyKey      String?
}

/// Composition rules that are properties of the preset ITSELF rather than of a
/// relationship. One row per version, keeping its own history. AEH-244.
///
/// This held `requires` and `blocks` as untyped string arrays until AEH-242 moved
/// them to PresetDependency. What is left is a node property: a statement about
/// this work on its own, not about a pair.
model PresetComposition {
  id              String        @id @default(cuid())
  presetVersionId String        @unique
  presetVersion   PresetVersion @relation(fields: [presetVersionId], references: [id])
  /// Whether this work has historically been delivered alongside other work.
  /// A scheduling hint for resource planning, NOT a dependency: two presets can
  /// both be un-parallelisable without either needing the other.
  canParallel     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

/// One dependency edge: `dependentVersion` needs `prerequisitePreset` before it
/// can be delivered. AEH-242.
///
/// ONE directed kind, deliberately. This replaces two hand-maintained string
/// arrays — `requires` ("I need those") and `blocks` ("I must precede those") —
/// which express the same relation from opposite ends. Kept apart, they drifted:
/// in the retired library 35 of 88 edges existed only in `blocks` and 19 only in
/// `requires`, and their union held a cycle (P27 -> P34 -> P38 -> P27) that no
/// code could catch, because nothing enforced direction or integrity. A second
/// kind is a second chance for the data to contradict itself. Adding a `kind`
/// column later is cheap; removing one after rows exist is not.
///
/// The two ends are deliberately asymmetric:
///   - the dependent is a VERSION, so composition keeps the per-version history
///     AEH-244 gave it — "what did v3 of this preset say it needed" stays
///     answerable.
///   - the prerequisite is a PRESET, because a version is a moving target. An
///     edge pinned to a version would break the moment that target is
///     re-versioned, which happens on every actuals writeback.
///
/// The field names state the direction. A column called `requires` read as a
/// noun is exactly the ambiguity this model exists to remove.
///
/// Two invariants SQL cannot express here, enforced in `preset-graph.ts` and
/// covered by its tests: no self-edge (the two ends live in different tables, so
/// a CHECK cannot see both), and no cycle.
model PresetDependency {
  id                   String        @id @default(cuid())
  /// The version that declares the need.
  dependentVersionId   String
  dependentVersion     PresetVersion @relation(fields: [dependentVersionId], references: [id], onDelete: Cascade)
  /// What it needs. Stable across the target's own versioning.
  prerequisitePresetId String
  prerequisitePreset   Preset        @relation(fields: [prerequisitePresetId], references: [id], onDelete: Cascade)
  /// Why this edge exists, in a sentence — "certificates cannot be delivered
  /// without transactional email". Optional, but it is the difference between a
  /// graph a human can audit and one they have to take on faith.
  note                 String?
  createdAt            DateTime      @default(now())

  @@unique([dependentVersionId, prerequisitePresetId])
  @@index([prerequisitePresetId])
}

// ─── Prompts ─────────────────────────────────────────────────────────────────

model Prompt {
  kind     AgentKind       @id
  versions PromptVersion[]
}

model PromptVersion {
  id               String           @id @default(cuid())
  kind             AgentKind
  prompt           Prompt           @relation(fields: [kind], references: [kind])
  version          Int
  body             String
  modelString      String
  active           Boolean          @default(false)
  changeReason     String?
  changeMotivation ChangeMotivation @default(OTHER)
  createdAt        DateTime         @default(now())
  createdBy        String?

  @@unique([kind, version])
}

// ─── Estimation Config ────────────────────────────────────────────────────────

model EstimationConfig {
  id                       String           @id @default(cuid())
  version                  Int              @unique
  active                   Boolean          @default(false)
  complexityRules          Json
  pmCommunicationTaxPct    Float
  baCommunicationTaxPct    Float
  qaRegressionBufferPct    Float
  /// Does an unresolved hidden-work finding stop an estimate being finalised,
  /// or merely say so?
  ///
  /// Defaults to false — warn — deliberately. A blocking gate is only as good as
  /// the Detective's precision, and nobody has run this stage against real SOWs
  /// yet. Starting in warn mode lets a team see what it actually catches before
  /// deciding it may stand between them and sending an estimate; flipping it on
  /// is one admin edit and no deploy. AEH-263.
  hiddenWorkBlocksFinalise Boolean          @default(false)
  infraBaseline            Json
  changeReason             String?
  changeMotivation         ChangeMotivation @default(OTHER)
  createdAt                DateTime         @default(now())
}

// ─── MCP Connectors ───────────────────────────────────────────────────────────

model McpConnector {
  id         String   @id @default(cuid())
  name       String
  transport  String
  endpoint   String
  authRef    String?
  enabled    Boolean  @default(false)
  lastTestOk Boolean?
  createdAt  DateTime @default(now())
}

// ─── Estimates ────────────────────────────────────────────────────────────────

model Estimate {
  id              String               @id @default(cuid())
  title           String
  sowText         String
  status          EstimateStatus       @default(DRAFT)
  complexityScore Int?
  configVersion   Int
  narrative       String[]
  assumptions     String[]
  agentState      Json
  ownerId         String
  owner           User                 @relation("EstimateOwner", fields: [ownerId], references: [id])
  /// Who is answerable for moving this estimate along — as opposed to whoever
  /// happened to create it, which is all `ownerId` has ever meant.
  ///
  /// A second column rather than a reinterpretation of the first, because the
  /// two are different acts: reassigning ownership is what you do when someone
  /// leaves (admin/users, in bulk), handing over custody is what you do when
  /// someone goes on leave for a fortnight. Only custody moves the reminders.
  ///
  /// Null means nobody has taken it on, and reminders fall back to the owner —
  /// a deadline with no custodian must still reach a person.
  custodianId     String?
  custodian       User?                @relation("EstimateCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  /// When this estimate is due, stored as midnight UTC of the chosen date.
  ///
  /// A date, not an instant: nobody sets an estimate deadline to 4:30pm. The
  /// canonical-midnight convention is what lets the sweep do integer day
  /// arithmetic (lib/reminders.ts) instead of guessing at timezones, and it is
  /// why every render of this column formats in UTC — in a negative-offset
  /// browser, local formatting would show the day before the one that was
  /// picked.
  ///
  /// Null means no deadline, which is the only state in which no reminder is
  /// ever sent.
  dueAt           DateTime?
  reminders       EstimateReminder[]
  sections        EstimateSection[]
  menuItems       MenuItem[]
  /// This estimate's dependency graph, between its own cards. First-class data
  /// about the project, not a projection of the preset library. See AEH-235.
  dependencies    MenuItemDependency[]
  /// Configured scopes cut from this estimate for presales. Planning artifacts:
  /// they never write back to the estimate's own card state.
  scopeScenarios  ScopeScenario[]
  uploadedFiles   UploadedFile[]
  hiddenWork      HiddenWorkFinding[]
  oracleThreads   OracleThread[]
  /// Supporting documents generated from this estimate. Presales deliverables:
  /// like scopeScenarios, they read the estimate and never write back to it.
  artifacts       EstimateArtifact[]
  modelUsage      ModelUsage[]
  sheetUrl        String?
  createdAt       DateTime             @default(now())

  // ── Run progress (background job + reload-safe polling) ──────────────────────
  runStatus     RunStatus @default(IDLE)
  runStage      String?
  runPct        Int       @default(0)
  runError      String?
  runStartedAt  DateTime?
  runFinishedAt DateTime?

  // ── Ingestion progress (uploaded client material → SOW) ──────────────────────
  ingestStatus RunStatus @default(IDLE)
  ingestStage  String?
  ingestPct    Int       @default(0)
  ingestError  String?
}

/// One deadline reminder already sent for one estimate.
///
/// A table rather than a flag on Estimate, because the sweep runs inside a
/// retriable Inngest step: "have we already nagged about this deadline" has to
/// be a fact the database enforces, not something the step hopes it finished
/// writing before it died. The unique key is the whole mechanism.
///
/// Rows are deleted when `dueAt` changes (actions.ts setDueAt, in the same
/// transaction as the change). A moved deadline is a new deadline, and none of
/// its reminders have been sent yet.
model EstimateReminder {
  id         String       @id @default(cuid())
  estimateId String
  estimate   Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  kind       ReminderKind
  /// The address it actually went to, so "why didn't I get one" is answerable
  /// without reconstructing who held custody at the time.
  sentTo     String
  /// False when SMTP is unconfigured or the send failed. The row is written
  /// either way: retrying a failed send forever would mail somebody three times
  /// the moment SMTP came back, and a missing nudge is visible in the rail.
  delivered  Boolean      @default(false)
  sentAt     DateTime     @default(now())

  @@unique([estimateId, kind])
  @@index([estimateId])
}

// User-editable grouping of menu items on an estimate. Purely presentational
// (the AI run never populates these — items start Ungrouped, i.e. sectionId
// null). Deleting a section detaches its items (SetNull) rather than losing
// them; deleting the estimate cascades.
model EstimateSection {
  id         String     @id @default(cuid())
  estimateId String
  estimate   Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  title      String
  order      Int        @default(0)
  menuItems  MenuItem[]
  createdAt  DateTime   @default(now())

  @@index([estimateId])
}

// Transient storage for uploaded client material so the background ingestion
// function (Inngest) can read the bytes after the upload request returns — the
// upload handler can't hold them in memory on serverless. Rows are deleted once
// ingestion completes.
model UploadedFile {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  bytes      Bytes
  createdAt  DateTime @default(now())

  @@index([estimateId])
}

/// A risk the Detective raised, and what became of it.
///
/// RiskFindings were never persisted at all — a run kept only
/// `agentState.detectiveRiskCount`, so the reasoning behind an estimate died
/// with the run that produced it. This table is what makes "hidden work versus
/// work that was asked for" answerable in SQL, and it is the corpus Oracle
/// (AEH-263 / AEH-259) reads to say which risks were claimed.
///
/// Keyed unique per (estimate, flag): the same worry raised against two
/// requirements is one piece of work, and a re-run must not duplicate a row or
/// overwrite a decision a human already made about it.
model HiddenWorkFinding {
  id            String            @id @default(cuid())
  estimateId    String
  estimate      Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  /// Free-form by design — off-list flags are exactly the ones a human must see.
  riskFlag      String
  /// Whether the pipeline had a taxonomy key and could cost it without asking.
  known         Boolean           @default(false)
  /// The Detective's own words, so whoever decides has the argument in front of them.
  claim         String
  citation      String
  requirementId String
  taxonomyKey   String?
  outcome       HiddenWorkOutcome @default(OPEN)
  /// The card this became, when it was costed. Cleared by a re-run, which
  /// deletes and recreates every menu item; the outcome deliberately survives.
  menuItemId    String?
  dismissReason String?
  dismissedById String?
  dismissedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@unique([estimateId, riskFlag])
  @@index([estimateId])
}

model MenuItem {
  id             String               @id @default(cuid())
  estimateId     String
  estimate       Estimate             @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  taxonomyKey    String
  /// Controlled-vocabulary category (see @repo/shared CategorySchema); optional
  /// for legacy/injected items (baseline, hidden-work) predating the envelope.
  category       String?
  /// Controlled-vocabulary phase: Foundation | Core | Enhancement.
  phase          String?
  sourcePresetId String?
  matchScore     Float?
  title          String
  enabled        Boolean              @default(true)
  /// Injected placeholder (hidden-work audit), not delivered feature work.
  /// Promotion reads this to keep placeholders out of the preset library.
  ///
  /// A real column rather than a `meta` key precisely because behaviour depends
  /// on READING it: `meta` is write-only everywhere in this repo, and the guard
  /// this replaces keyed on an `id` string prefix that persistence discards
  /// (Prisma mints a cuid), so it was dead and nothing noticed. See AEH-227.
  injected       Boolean              @default(false)
  /// User-assigned section grouping (null = Ungrouped). Presentational only.
  sectionId      String?
  section        EstimateSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// Manual ordering within a section (drag-and-drop). Ascending.
  order          Int                  @default(0)
  /// Always included in a configured scope: the toggle is shown but inert.
  ///
  /// A per-estimate decision, not a preset flag, and deliberately not derived
  /// from `meta.notSafelyRemovable` — that value is a constant. It is computed
  /// from `sequencing.prerequisitePresetIds`, which the Archivist derives by
  /// walking PresetDependency, and that table is empty, so it is false for
  /// every card in existence. See AEH-235.
  foundation     Boolean              @default(false)
  /// Extra envelope structure that doesn't warrant its own column yet:
  /// requirementIds, toggleable, notSafelyRemovable, thinSlice.
  meta           Json?
  lineItems      RoleLineItem[]
  /// This card's place in its estimate's dependency graph. Two sides, because
  /// an edge is directed and both ends are cards in the same estimate.
  dependsOn      MenuItemDependency[] @relation("DependentCard")
  requiredBy     MenuItemDependency[] @relation("PrerequisiteCard")
  /// Scenarios in which somebody explicitly switched this card on.
  scopePicks     ScopeScenarioPick[]

  @@index([estimateId])
  @@index([sectionId])
}

/// One configured scope over an estimate — a planning artifact.
///
/// Separate from the estimate's own `MenuItem.enabled` on purpose. The estimate
/// screen is where a team validates what the work actually is before finalising;
/// this is a presales planning tool, and a client-facing what-if must not
/// rewrite the estimate underneath the people who own it. So a scenario holds
/// its own state, carries its own author and name, and is auditable on its own.
///
/// Several scenarios per estimate are allowed by the schema (different cuts for
/// different conversations), even though the first screen only drives one.
model ScopeScenario {
  id          String              @id @default(cuid())
  estimateId  String
  estimate    Estimate            @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name        String
  /// Who cut this scope. Not the estimate's owner — the person in the room.
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  picks       ScopeScenarioPick[]

  @@index([estimateId])
}

/// One card a human explicitly switched on in a scenario.
///
/// Picks are the ONLY durable selection state. What is actually switched on is
/// derived from them on every read by `resolveSelection`, which pulls in each
/// pick's prerequisites transitively and adds the estimate's foundation cards.
///
/// Storing the resolved selection instead would mean two representations of one
/// fact, drifting apart the moment an edge changes underneath them — and it
/// would lose provenance, which is the thing the UI most needs to show. A card
/// that is on without a pick is on because something else needs it, and that is
/// exactly what a client has to be told when a cascade adds work they did not
/// ask for. The reference artifact this feature was specified against could not
/// distinguish the two.
model ScopeScenarioPick {
  id         String        @id @default(cuid())
  scenarioId String
  scenario   ScopeScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, menuItemId])
  @@index([menuItemId])
}

/// How an edge in an estimate's dependency graph came to exist.
///
/// Two values, and deliberately no third for "suggested by the preset library".
/// Library edges are never propagated into an estimate: every project is
/// different, so what one project needed says nothing about what this one
/// needs. An edge here was either worked out for THIS scope or typed by a
/// person who knows it. See MenuItemDependency.
enum DependencySource {
  /// Derived for this estimate from its own scope.
  INFERRED
  /// Authored by a human.
  MANUAL
}

/// One dependency between two cards of the SAME estimate: `dependent` cannot be
/// delivered before `prerequisite`.
///
/// The estimate owns its dependency graph. That is the whole point of this
/// model: dependencies are a property of the project being built, so they are
/// computed for that project and live on it.
///
/// The preset library's own graph (PresetDependency, AEH-242) is a RECORD, not
/// a source. Promotion preserves an estimate's graph into it so the knowledge
/// is not lost, and the library uses it for its own views — delivery waves, the
/// critical path, what a preset historically needed. It is never read back into
/// an estimate. Every project is different, so one project's ordering is a
/// reference a human might consult, not an input to another project's graph;
/// and presets arrive one card at a time on eligibility, so nothing guarantees
/// both ends of a library edge are even present again.
///
/// Requiring presets here would also make the configurator unavailable on real
/// work: only 12 of 140 cards carry a `sourcePresetId` at all.
///
/// Cascade on both ends, and no attempt to survive a re-run. A run deletes and
/// recreates every MenuItem, so an edge keyed on a card id cannot outlive one —
/// and should not, because the cards it joined are gone and a graph over
/// replaced work would be a lie. The graph is recomputed with the estimate.
model MenuItemDependency {
  id             String           @id @default(cuid())
  /// Denormalised from both ends so a whole estimate's graph loads in one query
  /// without joining through MenuItem twice. Both cards are always in this
  /// estimate; nothing may write an edge that leaves it.
  estimateId     String
  estimate       Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  dependentId    String
  dependent      MenuItem         @relation("DependentCard", fields: [dependentId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   MenuItem         @relation("PrerequisiteCard", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  /// Why this edge exists, in a sentence — "certificates cannot be issued
  /// before transactional email works". Optional, but it is the difference
  /// between a graph a human can audit and one they have to take on faith, and
  /// it is what the cascade notice shows when work disappears.
  note           String?
  source         DependencySource @default(INFERRED)
  createdAt      DateTime         @default(now())

  /// One edge per ordered pair. A second reading of the same dependency is the
  /// same dependency.
  @@unique([dependentId, prerequisiteId])
  @@index([estimateId])
  @@index([prerequisiteId])
}

model RoleLineItem {
  id              String   @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  role            RoleKind
  /// Short description of this atomic (<=4h) unit of work. Many rows per
  /// (menuItemId, role) now — the FOUR-HOUR RULE decomposes each role's
  /// scope into multiple line items instead of one lump number.
  title           String?
  baseHours       Float
  taxedHours      Float
  notes           String?
  edited          Boolean  @default(false)
  /// Which side of the stack this unit of work touches. Only meaningful for
  /// role = DEV; the hours stay a SINGLE combined number — these say what the
  /// number covers, they do not split it.
  ///
  /// Both false = not yet tagged (every row predating this column, plus
  /// hand-entered ones). Both true = genuinely full-stack. Presets carry
  /// beHours/feHours separately, so summing DEV rows by these flags is what
  /// lets writeback map an estimate onto a preset exactly instead of
  /// fabricating the frontend share.
  touchesFrontend Boolean  @default(false)
  touchesBackend  Boolean  @default(false)
  /// Extra envelope structure: id (DEV-REQ003-04), requirementId, complexity
  /// tier, aiAssistApplied, dependsOn, anchorPresetIds.
  meta            Json?

  @@index([menuItemId, role])
}

// ─── Oracle ───────────────────────────────────────────────────────────────────

/// One line of enquiry by one person about one estimate. AEH-259.
///
/// Threads are user-created and many-per-estimate on purpose: separate questions
/// stay separate, and each thread's replayed context stays bounded. A thread is
/// PRIVATE to the user who created it. Admins may read any thread and may never
/// post into one, so it stays a faithful record of one person's investigation —
/// there is deliberately no server action that writes a message on someone
/// else's behalf.
///
/// This is the first user-scoped read rule in the schema. Everything else here
/// is a shared workspace: Estimate.ownerId gates deletion and nothing else.
model OracleThread {
  id         String          @id @default(cuid())
  estimateId String
  estimate   Estimate        @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Derived from the opening question, not written by a model.
  title      String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  messages   OracleMessage[]
  usage      ModelUsage[]

  @@index([estimateId, userId])
}

/// One turn. Assistant turns carry a linked ModelUsage row (not inline columns)
/// so what the answer cost and which model wrote it is recorded in the one place
/// every other model call is recorded.
model OracleMessage {
  id       String       @id @default(cuid())
  threadId String
  thread   OracleThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role     OracleRole
  content  String

  /// Verbatim spans this turn quoted, as emitted. Whether a span is still found
  /// in the corpus is recomputed at render time rather than stamped here: a
  /// stored verdict would go stale the moment the source was edited, and the
  /// live check is what distinguishes a fabricated quote from a stale one.
  citations String[]

  /// sha256 of the estimate's sowText when this turn was written, and the run
  /// that was current at the time. Estimate.sowHash was dropped in AEH-253 with
  /// the cache layer that was its only reader, so the hash is computed here.
  ///
  /// Together with the live citation check these separate two different
  /// failures: a quote that is missing while the hash still matches was
  /// fabricated, and a quote that is missing because the hash moved is merely
  /// stale. Conflating them would hide the first.
  sowHash       String
  estimateRunAt DateTime?

  /// The cost of this turn, when it was an assistant turn. Lives on ModelUsage —
  /// the one home for all AI spend — rather than on this row, so a single report
  /// can answer "what did this cost" across Oracle and the run crew. A message
  /// has at most one usage row.
  usage ModelUsage?

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

/// One model call's actual cost, regardless of which surface made it.
///
/// The single source of AI spend. The run crew, Oracle, ingestion and embedding
/// all land here, tagged with the estimate, the run (for run-crew calls), and the
/// usage kind — so spend per estimate, per agent and per model is a query rather
/// than a guess. Rows accumulate across re-runs; nothing here is replaced
/// wholesale the way Estimate.agentState is.
model ModelUsage {
  id               String            @id @default(cuid())
  /// Null for preset embedding backfill (no estimate). SetNull, not Cascade: the
  /// spend record must outlive a deleted estimate.
  estimateId       String?
  estimate         Estimate?         @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  /// The run this call happened in. Null for Oracle/ingest/embedding.
  runId            String?
  kind             UsageKind
  /// The model as SERVED (fallback may differ from configured).
  model            String?
  promptTokens     Int?
  completionTokens Int?
  /// USD, as reported by the provider; null = unknown (distinct from zero).
  costUsd          Float?
  /// Oracle assistant turns link back to their message so the transcript can
  /// still show per-message cost. SetNull so a usage row survives deleting the
  /// message/thread, matching the estimate rule above.
  oracleMessageId  String?           @unique
  oracleMessage    OracleMessage?    @relation(fields: [oracleMessageId], references: [id], onDelete: SetNull)
  threadId         String?
  thread           OracleThread?     @relation(fields: [threadId], references: [id], onDelete: SetNull)
  /// Which generated document this call was spent on. Null for everything that
  /// is not artifact generation.
  ///
  /// Not `@unique`, unlike `oracleMessageId`: one artifact is N+2 model calls
  /// (an outline, a section each, an assemble), and the whole point of the
  /// column is being able to add them up. SetNull for the same reason as
  /// `estimateId` — the spend record must outlive what it was spent on.
  artifactId       String?
  artifact         EstimateArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([estimateId, createdAt])
  @@index([kind])
  @@index([runId])
  @@index([threadId])
  @@index([artifactId])
}

// ─── Artifacts ────────────────────────────────────────────────────────────────

/// One kind of supporting document an estimate can produce — an ERD, a user
/// journey map, a low-fidelity wireframe pack, a phased delivery plan.
///
/// A ROW, emphatically not an enum. AEH-239's hard requirement is that a new
/// artifact type is addable through the UI with no code change, and `AgentKind`
/// is the counter-example that proves the point: adding an agent is a
/// migration. Everything specific to one artifact lives here and in
/// ArtifactTypeVersion; everything shared by all of them (the page shell, the
/// prompt envelope, the corpus builders) is code.
///
/// There is no `format` column. Every artifact assembles into one shared HTML
/// shell, so a format axis would have exactly one value on it.
model ArtifactType {
  id          String                @id @default(cuid())
  /// Readable, stable handle used in URLs — "entity-model". Derived from the
  /// name on create and then frozen, because it is what a bookmarked admin URL
  /// points at.
  key         String                @unique
  name        String
  /// What this artifact is, in the author's words. Shown when picking one to
  /// generate — the only description a user ever sees, since nothing about a
  /// type is described in code.
  description String?
  /// Archived rather than deleted. A generated artifact is a client
  /// deliverable, so its type must remain resolvable forever; disabling only
  /// removes it from the "generate" picker.
  enabled     Boolean               @default(true)
  order       Int                   @default(0)
  createdAt   DateTime              @default(now())
  versions    ArtifactTypeVersion[]
  artifacts   EstimateArtifact[]
}

/// One version of what an artifact type asks for.
///
/// `PromptVersion` with two more fields and a foreign key instead of an enum
/// id, and it holds the same single-active-per-parent invariant by the same
/// `$transaction` pattern as `activateVersion`.
///
/// `promptBody` is the author's BRIEF, not the whole prompt. The contract the
/// machine depends on — the outline JSON shape, "return a fragment and never a
/// whole document", the selector-scoping rule, the CSS token vocabulary, the
/// per-section output budget — lives in a code-owned envelope wrapped around
/// this at call time. That split is what stops a prompt edit breaking
/// generation, and it matters because every type here is hand-authored with no
/// seeded example to copy from.
model ArtifactTypeVersion {
  id               String           @id @default(cuid())
  artifactTypeId   String
  artifactType     ArtifactType     @relation(fields: [artifactTypeId], references: [id], onDelete: Cascade)
  version          Int
  /// The author's brief. See the note above: this is not the whole prompt.
  promptBody       String
  modelString      String
  /// Which named slices of the estimate this type is shown, by key — "cards",
  /// "requirements", "graph". Validated against the dossier's catalogue at
  /// generation time rather than by the database, so that retiring a section
  /// degrades one type instead of failing a migration.
  corpusSections   String[]
  active           Boolean          @default(false)
  changeReason     String?
  changeMotivation ChangeMotivation @default(OTHER)
  createdAt        DateTime         @default(now())
  createdBy        String?

  @@unique([artifactTypeId, version])
}

/// One generated document, belonging to one estimate.
///
/// Generation is an Inngest job of N+2 steps — an outline, one per section,
/// then assemble — because Inngest invokes one `step.run()` per HTTP request
/// and so gives each step its own 300s. That is the only way a ~25k-token
/// document is producible on a deploy target whose per-step ceiling is a hard
/// 300s with no Pro headroom. It is the same reason `runEstimate` checkpoints
/// per agent.
///
/// Progress columns live HERE rather than on Estimate. The scope-map route
/// already recorded why: the run and ingest progress columns are per-job-type,
/// and a third set on Estimate would be a worse trade. An artifact is its own
/// job, so it carries its own.
model EstimateArtifact {
  id             String            @id @default(cuid())
  estimateId     String
  estimate       Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  artifactTypeId String
  artifactType   ArtifactType      @relation(fields: [artifactTypeId], references: [id])
  /// The type version this was generated from, snapshotted. A delivered
  /// document must still be able to say what produced it after the type has
  /// been edited half a dozen times.
  typeVersion    Int
  title          String
  /// The section plan from step 1, kept so the UI can show what is coming
  /// while the sections are still being written, and so a failed run can be
  /// read after the fact.
  outline        Json?
  /// The assembled document. Null until the final step succeeds — presence
  /// here is what "finished" means. Can be ~100KB: never select it in a list
  /// query.
  content        String?
  /// Per-generation inputs the type's brief may refer to — which saved
  /// ScopeScenario to cut against, for instance. Present from the first
  /// migration because re-allocation provenance and tranche impact both need
  /// it, and adding the column later is precisely the migration this ticket
  /// exists to abolish.
  /// @orphan-todo AEH-239 written by the generate route, read by nothing yet — no authored type asks for an input, and a picker for a question nobody is asking would be invented UI.
  inputs         Json?
  status         RunStatus         @default(IDLE)
  stage          String?
  pct            Int               @default(0)
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdBy      String?
  createdAt      DateTime          @default(now())
  sections       ArtifactSection[]
  modelUsage     ModelUsage[]

  @@index([estimateId, createdAt])
  @@index([artifactTypeId])
}

/// One section of one generated document, written by its own durable step.
///
/// A table rather than a JSON column on EstimateArtifact, and that is the
/// checkpoint the whole design rests on: each step upserts its own row on
/// `(artifactId, sectionId)` as it completes, so a retry cannot duplicate and a
/// failure at section 5 of 9 does not throw away sections 1 to 4. A JSON column
/// would make every step a read-modify-write of the same value.
///
/// `html` is a fragment — markup, `<style>` and `<script>` all authored by the
/// model, scoped under this section's own element. There is no template
/// constraining it, deliberately: a low-fidelity wireframe's layout IS its
/// content, so templating it would put the interesting part back in code.
model ArtifactSection {
  id         String           @id @default(cuid())
  artifactId String
  artifact   EstimateArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  /// The outline's own id for this section — a slug, stable across a retry,
  /// and what the assembled shell uses as the section element's handle and
  /// nav anchor.
  sectionId  String
  order      Int
  title      String
  /// What this section was asked to contain. Kept because later sections are
  /// shown the briefs of earlier ones — never their HTML — which is how the
  /// document stays coherent across independent calls.
  brief      String
  html       String
  createdAt  DateTime         @default(now())

  @@unique([artifactId, sectionId])
  @@index([artifactId, order])
}
