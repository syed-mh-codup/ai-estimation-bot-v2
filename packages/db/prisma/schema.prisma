generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/client"
}

datasource db {
  provider   = "postgresql"
  // App connections use the (pooled) DATABASE_URL. Migrations need a DIRECT
  // (non-pooled) connection — on Neon the pooler can't run DDL/advisory locks.
  // Locally DIRECT_URL can equal DATABASE_URL.
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ESTIMATOR
}

enum ChangeMotivation {
  UPSKILL
  TECH_ADVANCEMENT
  NEW_PROCESS
  POST_DELIVERY_VALIDATION
  CORRECTION
  OTHER
}

enum DataVolume {
  NONE
  LOW
  HIGH
}

enum PresetPhase {
  FOUNDATION
  CORE
  ENHANCEMENT
}

enum Level {
  LOW
  MEDIUM
  HIGH
}

enum AgentKind {
  SUPERVISOR
  LIBRARIAN
  DETECTIVE
  ARCHIVIST
  SPECIALIST_DEV
  SPECIALIST_QA
  SPECIALIST_PM
  SPECIALIST_BA
  ARCHITECT
  /// Not part of a run. Oracle answers questions about one estimate on demand;
  /// it is an agent rather than an artifact type, which is why it belongs in
  /// this enum. See packages/db/src/agent-catalogue.ts for what each kind is.
  ORACLE
}

/// The attribution vocabulary for ModelUsage rows. Owned in code by
/// packages/db/src/usage-catalogue.ts (USAGE_KINDS); the completeness test fails
/// when this and the catalogue drift. Agent-shaped values are the AgentKind
/// strings; INGEST and PRESET_EMBEDDING are model surfaces that are not agents.
enum UsageKind {
  SUPERVISOR
  LIBRARIAN
  DETECTIVE
  ARCHIVIST
  SPECIALIST_DEV
  SPECIALIST_QA
  SPECIALIST_PM
  SPECIALIST_BA
  ARCHITECT
  ORACLE
  INGEST
  /// Preset-library embedding only. An Archivist query embed is recorded as
  /// ARCHIVIST, because "which agent is burning the money" is the question the
  /// kind exists to answer, and that spend is the Archivist's. So this value is
  /// deliberately narrow: it is the backfill sweep, not "all embedding spend" —
  /// that is a query on `model`, not on `kind`.
  PRESET_EMBEDDING
}

/// Who wrote an Oracle turn. Oracle has no tool calls and no system turns in the
/// transcript — the system prompt is the live PromptVersion, not a stored row —
/// so two values is the whole vocabulary.
enum OracleRole {
  USER
  ASSISTANT
}

enum EstimateStatus {
  DRAFT
  REVIEW
  FINALISED
}

/// Which beat of the deadline sequence a reminder was. Three beats, deliberately:
/// a heads-up, the day itself, and the miss. One EstimateReminder row per
/// (estimate, kind) is what stops a retried sweep from nagging twice.
enum ReminderKind {
  /// Three days out or fewer, and not yet the due day.
  DUE_SOON
  /// The due date is today.
  DUE_TODAY
  /// The due date has passed.
  OVERDUE
}

enum RunStatus {
  IDLE
  RUNNING
  DONE
  FAILED
}

enum RoleKind {
  DEV
  QA
  PM
  BA
}

/// What happened to a risk the Detective raised.
///
/// A column rather than a derived state, because the whole point of the feature
/// is being able to ask later: what did we spot, what did we cost, and what did
/// we knowingly walk away from. That is a query, not a reconstruction.
enum HiddenWorkOutcome {
  /// Detected, nobody has decided yet. This is what the finalise gate counts.
  OPEN
  /// Known flag, costed automatically by the Specialist council.
  AUTO_COST
  /// A person costed it into a card by hand.
  ACCEPTED
  /// A person said existing work already covers it.
  COVERED
  /// A person decided not to cost it, and said why.
  DISMISSED
}

/// Governance state of a taxonomy node. The taxonomy was originally derived
/// wholesale from the preset library with no authoring surface; once nodes can
/// be proposed by a run, "is this node real yet" has to be a queryable fact
/// rather than a convention. AEH-263.
enum TaxonomyStatus {
  /// Proposed by a run, not yet reviewed. Invisible to the Librarian.
  PROPOSED
  /// Accepted by an admin. This is the only status the Librarian classifies against.
  ACTIVE
  /// Folded into another node by an admin; collapsedIntoKey names the survivor.
  COLLAPSED
}

/// How a preset entered the library. Stored as a column, not inferred from the
/// code prefix — "show me everything validated against delivery" should be a
/// query, not a string match.
enum PresetOrigin {
  /// Imported from docs/Estimate Presets (ISM).xlsx.
  SEEDED
  /// Written back from a finalised estimate.
  FINALISED
  /// Entered by hand in the admin UI.
  MANUAL
}

// ─── Identity & Access ────────────────────────────────────────────────────────

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  hash              String
  name              String?
  role              Role           @default(ESTIMATOR)
  createdAt         DateTime       @default(now())
  /// When set, this account can no longer sign in AND its live sessions stop
  /// working. Blocking `authorize()` alone would only stop NEW logins — with
  /// `session: { strategy: 'jwt' }` there is no session table to revoke, so an
  /// already-signed-in user would keep working until their token expired. The
  /// DB-backed jwt callback (auth.ts) re-reads this every request, which is what
  /// actually ends a session.
  ///
  /// Disabling is the answer when ownership history should be preserved;
  /// delete-and-reassign is the answer when it shouldn't. Both exist.
  disabledAt        DateTime?
  /// Set when the password changes, so live sessions issued before that can be
  /// rejected by the same DB-backed jwt callback. Without it, changing a
  /// password does not sign other devices out.
  passwordChangedAt DateTime?
  estimates         Estimate[]     @relation("EstimateOwner")
  /// Estimates this user is answerable for, which is not the same set as the
  /// ones they created. See Estimate.custodianId.
  custodianOf       Estimate[]     @relation("EstimateCustodian")
  oracleThreads     OracleThread[]
}

// ─── Taxonomy ─────────────────────────────────────────────────────────────────

model TaxonomyNode {
  id               String                @id @default(cuid())
  key              String                @unique
  label            String
  parentKey        String?
  /// Governance state. Only ACTIVE nodes reach the Librarian's classification
  /// vocabulary (run-estimate.ts loadTaxonomyEntries), so a PROPOSED node
  /// changes no estimate until an admin accepts it. That filter is what bounds
  /// the blast radius of adding nodes at all. AEH-263.
  status           TaxonomyStatus        @default(ACTIVE)
  /// Set when an admin collapses a proposal into an existing node instead of
  /// accepting it. Bare key like parentKey (no relation) — same idiom, and the
  /// admin action validates the target exists. Reads resolve through it.
  collapsedIntoKey String?
  /// May the Librarian assign this key to a SOW requirement?
  ///
  /// A different axis from `status`, and the distinction is load-bearing: status
  /// asks "is this node real", classifiable asks "can a client ask for it".
  /// `process.code-review` is real, referenceable and promotable, but nobody
  /// writes "do code reviews" in a statement of work — offering it to the
  /// Librarian only invites a real requirement to be misclassified as overhead.
  /// `infra.rate-limit` is the opposite: a client absolutely can ask for rate
  /// limiting, and when they do it is asked-for work under that key, which is
  /// also how the hidden-work audit sees it is already covered. AEH-263.
  classifiable     Boolean               @default(true)
  versions         TaxonomyNodeVersion[]
}

model TaxonomyNodeVersion {
  id               String           @id @default(cuid())
  nodeKey          String
  node             TaxonomyNode     @relation(fields: [nodeKey], references: [key])
  version          Int
  label            String
  reqType          String?
  keywords         String[]
  active           Boolean          @default(false)
  changeReason     String?
  changeMotivation ChangeMotivation @default(OTHER)
  createdAt        DateTime         @default(now())
  createdBy        String?

  @@unique([nodeKey, version])
}

// ─── Preset Library ───────────────────────────────────────────────────────────

model Preset {
  /// cuid. Opaque and never allocated by a human — see `code` for the readable
  /// handle. The seeded 45 keep the ids they were imported under (P01–P45),
  /// which are load-bearing: requires/blocks form a real dependency graph
  /// between presets, MenuItem.sourcePresetId rows point at them, and live
  /// agent prompts name the range.
  id       String          @id @default(cuid())
  /// Readable handle — "P46". Unique, shown everywhere, never typed by a user:
  /// allocated from a Postgres sequence (see allocatePresetCode) so concurrent
  /// finalises can't collide the way max()+1 would.
  ///
  /// Numbers are free-flowing — no zero padding, no fixed width. Codes imported
  /// from the xlsx keep that file's own formatting (P01–P45) because people
  /// cross-reference the spreadsheet; allocated codes are plain (P46, P100).
  code     String?         @unique
  /// Where this preset came from. See PresetOrigin.
  origin   PresetOrigin    @default(MANUAL)
  versions PresetVersion[]
}

model PresetVersion {
  id       String  @id @default(cuid())
  presetId String
  preset   Preset  @relation(fields: [presetId], references: [id])
  version  Int
  active   Boolean @default(false)

  /// The estimate anchor — one per version, carrying the hours, side flags and
  /// comparison signals a preset contributes to an estimate. AEH-244 split this
  /// out so the anchor can become a first-class costed-work record (AEH-243).
  anchor      PresetAnchor?
  /// The retrieval surface — one per version, self-contained: it holds every
  /// field the embedding is built from, so computing a row's own vector never
  /// requires a join to a sibling table.
  retrieval   PresetRetrieval?
  /// The composition rules — one per version, so requires/blocks/canParallel
  /// keep their own history exactly like the anchor and retrieval do.
  composition PresetComposition?

  changeReason     String?
  changeMotivation ChangeMotivation @default(OTHER)
  createdAt        DateTime         @default(now())
  createdBy        String?
  sourceEstimateId String?
  /// Which menu item of that estimate this version came from. Together with
  /// sourceEstimateId this is the idempotency key for promotion — re-finalising
  /// must not stack duplicate versions. It used to be implicit in a synthesised
  /// preset id (`promoted-<estimateId>-<itemId>`); now that ids are cuids the
  /// key has to be a real column.
  sourceMenuItemId String?

  @@unique([presetId, version])
}

/// What makes a preset findable — the retrieval surface for Archivist similarity
/// search. One row per version, mirroring the anchor's lifecycle, so a rename or
/// keyword edit is a new version with a real history rather than an in-place
/// overwrite. AEH-244.
///
/// Self-contained by construction: name, description, keywords, userStoryTags and
/// notes are the five fields `presetEmbeddingText` concatenates, and they all live
/// here — a retrieval row's embedding text is computable from the row alone.
model PresetRetrieval {
  id              String                       @id @default(cuid())
  presetVersionId String                       @unique
  presetVersion   PresetVersion                @relation(fields: [presetVersionId], references: [id])
  name            String
  description     String
  keywords        String[]
  /// B2B buyer | Dev ops | Marketing editor — feeds the embedding text.
  userStoryTags   String[]
  /// Key assumption; if violated -> change request. Also feeds the embedding
  /// text, because it carries retrieval-relevant meaning about what the preset
  /// actually assumes and excludes ("P21 order history API must be available").
  notes           String
  /// The exact text `embedding` was generated from. Present so staleness is
  /// decidable: an admin edit carries the old vector forward (never de-indexing
  /// the preset) and the backfill re-embeds any row whose current text no longer
  /// matches this. Null means "never embedded".
  embeddingText   String?
  /// pgvector embedding for Archivist similarity search
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

/// The estimate anchor — what a preset contributes to an estimate. One row per
/// version because the anchor changes with each version: a v2 may have different
/// hours or risk. Its own table and own ID so AEH-243 can decide whether this IS
/// the costed-work type or whether a separate CostedWork record references it.
/// AEH-244.
model PresetAnchor {
  id               String        @id @default(cuid())
  presetVersionId  String        @unique
  presetVersion    PresetVersion @relation(fields: [presetVersionId], references: [id])
  /// The preset's dev effort as ONE number. Frontend and backend are estimated
  /// together because delivery is full-stack — the split used to exist to
  /// allocate work across separate FE/BE resources, and that need is gone.
  devHours         Int
  /// Which sides of the stack this preset's work covers. Reference only: they
  /// describe `devHours`, they never divide it.
  touchesFrontend  Boolean       @default(false)
  touchesBackend   Boolean       @default(false)
  /// LEGACY, nullable, no longer written. The historical FE/BE split as recorded
  /// in the xlsx, retained because the decision to estimate as one figure may be
  /// revisited and this data can't be recovered. NULL means "not tracked".
  /// @backend-only Archived source data, kept because the xlsx FE/BE split cannot be reconstructed if the one-figure decision is ever revisited.
  beHours          Int?
  /// The frontend half of the same archived split; see beHours above.
  /// @backend-only Archived source data, kept because the xlsx FE/BE split cannot be reconstructed if the one-figure decision is ever revisited.
  feHours          Int?
  risk             Level
  aiAssist         Level
  dataVolume       DataVolume
  integrationCount Int
  projectSizeFit   String[]
  phase            PresetPhase
  spikeNeeded      Boolean
  category         String
  reqType          String
  platforms        String[]
  taxonomyKey      String?
}

/// How a preset relates to other modules — composition rules. One row per
/// version, so requires/blocks/canParallel keep their own history. AEH-244;
/// AEH-242 will likely turn requires/blocks into proper FK references.
model PresetComposition {
  id              String        @id @default(cuid())
  presetVersionId String        @unique
  presetVersion   PresetVersion @relation(fields: [presetVersionId], references: [id])
  /// Preset codes this one must precede (e.g. ["P17"]). No FK — AEH-242 will
  /// add referential integrity.
  requires        String[]
  /// Preset codes this one blocks (e.g. ["P18"]). No FK — same as requires.
  blocks          String[]
  canParallel     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ─── Prompts ─────────────────────────────────────────────────────────────────

model Prompt {
  kind     AgentKind       @id
  versions PromptVersion[]
}

model PromptVersion {
  id               String           @id @default(cuid())
  kind             AgentKind
  prompt           Prompt           @relation(fields: [kind], references: [kind])
  version          Int
  body             String
  modelString      String
  active           Boolean          @default(false)
  changeReason     String?
  changeMotivation ChangeMotivation @default(OTHER)
  createdAt        DateTime         @default(now())
  createdBy        String?

  @@unique([kind, version])
}

// ─── Estimation Config ────────────────────────────────────────────────────────

model EstimationConfig {
  id                       String           @id @default(cuid())
  version                  Int              @unique
  active                   Boolean          @default(false)
  complexityRules          Json
  pmCommunicationTaxPct    Float
  baCommunicationTaxPct    Float
  qaRegressionBufferPct    Float
  /// Does an unresolved hidden-work finding stop an estimate being finalised,
  /// or merely say so?
  ///
  /// Defaults to false — warn — deliberately. A blocking gate is only as good as
  /// the Detective's precision, and nobody has run this stage against real SOWs
  /// yet. Starting in warn mode lets a team see what it actually catches before
  /// deciding it may stand between them and sending an estimate; flipping it on
  /// is one admin edit and no deploy. AEH-263.
  hiddenWorkBlocksFinalise Boolean          @default(false)
  infraBaseline            Json
  changeReason             String?
  changeMotivation         ChangeMotivation @default(OTHER)
  createdAt                DateTime         @default(now())
}

// ─── MCP Connectors ───────────────────────────────────────────────────────────

model McpConnector {
  id         String   @id @default(cuid())
  name       String
  transport  String
  endpoint   String
  authRef    String?
  enabled    Boolean  @default(false)
  lastTestOk Boolean?
  createdAt  DateTime @default(now())
}

// ─── Estimates ────────────────────────────────────────────────────────────────

model Estimate {
  id              String              @id @default(cuid())
  title           String
  sowText         String
  status          EstimateStatus      @default(DRAFT)
  complexityScore Int?
  configVersion   Int
  narrative       String[]
  assumptions     String[]
  agentState      Json
  ownerId         String
  owner           User                @relation("EstimateOwner", fields: [ownerId], references: [id])
  /// Who is answerable for moving this estimate along — as opposed to whoever
  /// happened to create it, which is all `ownerId` has ever meant.
  ///
  /// A second column rather than a reinterpretation of the first, because the
  /// two are different acts: reassigning ownership is what you do when someone
  /// leaves (admin/users, in bulk), handing over custody is what you do when
  /// someone goes on leave for a fortnight. Only custody moves the reminders.
  ///
  /// Null means nobody has taken it on, and reminders fall back to the owner —
  /// a deadline with no custodian must still reach a person.
  custodianId     String?
  custodian       User?               @relation("EstimateCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  /// When this estimate is due, stored as midnight UTC of the chosen date.
  ///
  /// A date, not an instant: nobody sets an estimate deadline to 4:30pm. The
  /// canonical-midnight convention is what lets the sweep do integer day
  /// arithmetic (lib/reminders.ts) instead of guessing at timezones, and it is
  /// why every render of this column formats in UTC — in a negative-offset
  /// browser, local formatting would show the day before the one that was
  /// picked.
  ///
  /// Null means no deadline, which is the only state in which no reminder is
  /// ever sent.
  dueAt           DateTime?
  reminders       EstimateReminder[]
  sections        EstimateSection[]
  menuItems       MenuItem[]
  uploadedFiles   UploadedFile[]
  hiddenWork      HiddenWorkFinding[]
  oracleThreads   OracleThread[]
  modelUsage      ModelUsage[]
  sheetUrl        String?
  createdAt       DateTime            @default(now())

  // ── Run progress (background job + reload-safe polling) ──────────────────────
  runStatus     RunStatus @default(IDLE)
  runStage      String?
  runPct        Int       @default(0)
  runError      String?
  runStartedAt  DateTime?
  runFinishedAt DateTime?

  // ── Ingestion progress (uploaded client material → SOW) ──────────────────────
  ingestStatus RunStatus @default(IDLE)
  ingestStage  String?
  ingestPct    Int       @default(0)
  ingestError  String?
}

/// One deadline reminder already sent for one estimate.
///
/// A table rather than a flag on Estimate, because the sweep runs inside a
/// retriable Inngest step: "have we already nagged about this deadline" has to
/// be a fact the database enforces, not something the step hopes it finished
/// writing before it died. The unique key is the whole mechanism.
///
/// Rows are deleted when `dueAt` changes (actions.ts setDueAt, in the same
/// transaction as the change). A moved deadline is a new deadline, and none of
/// its reminders have been sent yet.
model EstimateReminder {
  id         String       @id @default(cuid())
  estimateId String
  estimate   Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  kind       ReminderKind
  /// The address it actually went to, so "why didn't I get one" is answerable
  /// without reconstructing who held custody at the time.
  sentTo     String
  /// False when SMTP is unconfigured or the send failed. The row is written
  /// either way: retrying a failed send forever would mail somebody three times
  /// the moment SMTP came back, and a missing nudge is visible in the rail.
  delivered  Boolean      @default(false)
  sentAt     DateTime     @default(now())

  @@unique([estimateId, kind])
  @@index([estimateId])
}

// User-editable grouping of menu items on an estimate. Purely presentational
// (the AI run never populates these — items start Ungrouped, i.e. sectionId
// null). Deleting a section detaches its items (SetNull) rather than losing
// them; deleting the estimate cascades.
model EstimateSection {
  id         String     @id @default(cuid())
  estimateId String
  estimate   Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  title      String
  order      Int        @default(0)
  menuItems  MenuItem[]
  createdAt  DateTime   @default(now())

  @@index([estimateId])
}

// Transient storage for uploaded client material so the background ingestion
// function (Inngest) can read the bytes after the upload request returns — the
// upload handler can't hold them in memory on serverless. Rows are deleted once
// ingestion completes.
model UploadedFile {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  bytes      Bytes
  createdAt  DateTime @default(now())

  @@index([estimateId])
}

/// A risk the Detective raised, and what became of it.
///
/// RiskFindings were never persisted at all — a run kept only
/// `agentState.detectiveRiskCount`, so the reasoning behind an estimate died
/// with the run that produced it. This table is what makes "hidden work versus
/// work that was asked for" answerable in SQL, and it is the corpus Oracle
/// (AEH-263 / AEH-259) reads to say which risks were claimed.
///
/// Keyed unique per (estimate, flag): the same worry raised against two
/// requirements is one piece of work, and a re-run must not duplicate a row or
/// overwrite a decision a human already made about it.
model HiddenWorkFinding {
  id            String            @id @default(cuid())
  estimateId    String
  estimate      Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  /// Free-form by design — off-list flags are exactly the ones a human must see.
  riskFlag      String
  /// Whether the pipeline had a taxonomy key and could cost it without asking.
  known         Boolean           @default(false)
  /// The Detective's own words, so whoever decides has the argument in front of them.
  claim         String
  citation      String
  requirementId String
  taxonomyKey   String?
  outcome       HiddenWorkOutcome @default(OPEN)
  /// The card this became, when it was costed. Cleared by a re-run, which
  /// deletes and recreates every menu item; the outcome deliberately survives.
  menuItemId    String?
  dismissReason String?
  dismissedById String?
  dismissedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@unique([estimateId, riskFlag])
  @@index([estimateId])
}

model MenuItem {
  id             String           @id @default(cuid())
  estimateId     String
  estimate       Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  taxonomyKey    String
  /// Controlled-vocabulary category (see @repo/shared CategorySchema); optional
  /// for legacy/injected items (baseline, hidden-work) predating the envelope.
  category       String?
  /// Controlled-vocabulary phase: Foundation | Core | Enhancement.
  phase          String?
  sourcePresetId String?
  matchScore     Float?
  title          String
  enabled        Boolean          @default(true)
  /// Injected placeholder (hidden-work audit), not delivered feature work.
  /// Promotion reads this to keep placeholders out of the preset library.
  ///
  /// A real column rather than a `meta` key precisely because behaviour depends
  /// on READING it: `meta` is write-only everywhere in this repo, and the guard
  /// this replaces keyed on an `id` string prefix that persistence discards
  /// (Prisma mints a cuid), so it was dead and nothing noticed. See AEH-227.
  injected       Boolean          @default(false)
  /// User-assigned section grouping (null = Ungrouped). Presentational only.
  sectionId      String?
  section        EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// Manual ordering within a section (drag-and-drop). Ascending.
  order          Int              @default(0)
  /// Extra envelope structure that doesn't warrant its own column yet:
  /// requirementIds, toggleable, notSafelyRemovable, thinSlice.
  meta           Json?
  lineItems      RoleLineItem[]

  @@index([sectionId])
}

model RoleLineItem {
  id              String   @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  role            RoleKind
  /// Short description of this atomic (<=4h) unit of work. Many rows per
  /// (menuItemId, role) now — the FOUR-HOUR RULE decomposes each role's
  /// scope into multiple line items instead of one lump number.
  title           String?
  baseHours       Float
  taxedHours      Float
  notes           String?
  edited          Boolean  @default(false)
  /// Which side of the stack this unit of work touches. Only meaningful for
  /// role = DEV; the hours stay a SINGLE combined number — these say what the
  /// number covers, they do not split it.
  ///
  /// Both false = not yet tagged (every row predating this column, plus
  /// hand-entered ones). Both true = genuinely full-stack. Presets carry
  /// beHours/feHours separately, so summing DEV rows by these flags is what
  /// lets writeback map an estimate onto a preset exactly instead of
  /// fabricating the frontend share.
  touchesFrontend Boolean  @default(false)
  touchesBackend  Boolean  @default(false)
  /// Extra envelope structure: id (DEV-REQ003-04), requirementId, complexity
  /// tier, aiAssistApplied, dependsOn, anchorPresetIds.
  meta            Json?

  @@index([menuItemId, role])
}

// ─── Oracle ───────────────────────────────────────────────────────────────────

/// One line of enquiry by one person about one estimate. AEH-259.
///
/// Threads are user-created and many-per-estimate on purpose: separate questions
/// stay separate, and each thread's replayed context stays bounded. A thread is
/// PRIVATE to the user who created it. Admins may read any thread and may never
/// post into one, so it stays a faithful record of one person's investigation —
/// there is deliberately no server action that writes a message on someone
/// else's behalf.
///
/// This is the first user-scoped read rule in the schema. Everything else here
/// is a shared workspace: Estimate.ownerId gates deletion and nothing else.
model OracleThread {
  id         String          @id @default(cuid())
  estimateId String
  estimate   Estimate        @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Derived from the opening question, not written by a model.
  title      String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  messages   OracleMessage[]
  usage      ModelUsage[]

  @@index([estimateId, userId])
}

/// One turn. Assistant turns carry a linked ModelUsage row (not inline columns)
/// so what the answer cost and which model wrote it is recorded in the one place
/// every other model call is recorded.
model OracleMessage {
  id       String       @id @default(cuid())
  threadId String
  thread   OracleThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role     OracleRole
  content  String

  /// Verbatim spans this turn quoted, as emitted. Whether a span is still found
  /// in the corpus is recomputed at render time rather than stamped here: a
  /// stored verdict would go stale the moment the source was edited, and the
  /// live check is what distinguishes a fabricated quote from a stale one.
  citations String[]

  /// sha256 of the estimate's sowText when this turn was written, and the run
  /// that was current at the time. Estimate.sowHash was dropped in AEH-253 with
  /// the cache layer that was its only reader, so the hash is computed here.
  ///
  /// Together with the live citation check these separate two different
  /// failures: a quote that is missing while the hash still matches was
  /// fabricated, and a quote that is missing because the hash moved is merely
  /// stale. Conflating them would hide the first.
  sowHash       String
  estimateRunAt DateTime?

  /// The cost of this turn, when it was an assistant turn. Lives on ModelUsage —
  /// the one home for all AI spend — rather than on this row, so a single report
  /// can answer "what did this cost" across Oracle and the run crew. A message
  /// has at most one usage row.
  usage     ModelUsage?

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

/// One model call's actual cost, regardless of which surface made it.
///
/// The single source of AI spend. The run crew, Oracle, ingestion and embedding
/// all land here, tagged with the estimate, the run (for run-crew calls), and the
/// usage kind — so spend per estimate, per agent and per model is a query rather
/// than a guess. Rows accumulate across re-runs; nothing here is replaced
/// wholesale the way Estimate.agentState is.
model ModelUsage {
  id       String   @id @default(cuid())
  /// Null for preset embedding backfill (no estimate). SetNull, not Cascade: the
  /// spend record must outlive a deleted estimate.
  estimateId       String?
  estimate         Estimate?       @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  /// The run this call happened in. Null for Oracle/ingest/embedding.
  runId            String?
  kind             UsageKind
  /// The model as SERVED (fallback may differ from configured).
  model            String?
  promptTokens     Int?
  completionTokens Int?
  /// USD, as reported by the provider; null = unknown (distinct from zero).
  costUsd          Float?
  /// Oracle assistant turns link back to their message so the transcript can
  /// still show per-message cost. SetNull so a usage row survives deleting the
  /// message/thread, matching the estimate rule above.
  oracleMessageId  String?         @unique
  oracleMessage    OracleMessage?  @relation(fields: [oracleMessageId], references: [id], onDelete: SetNull)
  threadId         String?
  thread           OracleThread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([estimateId, createdAt])
  @@index([kind])
  @@index([runId])
  @@index([threadId])
}
