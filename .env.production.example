# Production environment / secrets (WS28-01). Provide these via your host's
# secret manager — never commit real values. Required vars are validated at boot
# and by GET /api/health (503 if missing).

# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=""        # Neon POOLED url (…-pooler.…) with ?sslmode=require&pgbouncer=true — app queries
DIRECT_URL=""          # Neon DIRECT url (no -pooler) with ?sslmode=require — prisma migrate deploy
AUTH_SECRET=""         # openssl rand -base64 32
# AUTH_URL is NOT needed: auth.config uses trustHost:true (origin derived per request).

# ── Background jobs (required on serverless: Vercel/Netlify) ──────────────────
INNGEST_EVENT_KEY=""    # Inngest — send events (run/ingest triggers)
INNGEST_SIGNING_KEY=""  # Inngest — verify function invocations at /api/inngest

# ── Admin bootstrap (used once, by `pnpm db:seed:admin` — not app runtime) ───
# The production seed creates NO users by default. There is no default password;
# under 12 chars is rejected.  ADMIN_PASSWORD="$(openssl rand -base64 24)"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Integrations (optional — feature-gated) ──────────────────────────────────
OPENROUTER_API_KEY=""           # agent runs (chat) + embeddings
OPENROUTER_FALLBACK_MODEL=""     # optional fallback model id
TAVILY_API_KEY=""                # Detective search grounding; unset = no citations
GOOGLE_SERVICE_ACCOUNT_JSON=""   # Sheets export (LiveSheetsProvider)
GOOGLE_DRIVE_FOLDER_ID=""        # Sheets export target folder
ENCRYPTION_KEY=""                # MCP connector secret storage (aes-256-gcm master key)

# ── Completion emails (optional) — SMTP via Resend ───────────────────────────
# Unset ⇒ emails are skipped (jobs still complete). APP_URL must be the public
# origin so links in the emails resolve (e.g. https://estimates.codup.co).
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD=""                 # Resend API key
EMAIL_FROM="AI Estimation <estimates@yourdomain.com>"
APP_URL=""                       # e.g. https://estimates.codup.co

# NODE_ENV=production
