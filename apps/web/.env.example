# Copy to apps/web/.env.local — loaded by the Next.js dev server.

# Same value as packages/db/.env:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_estimation?schema=public"

# next-auth v5. Generate the secret with:  openssl rand -base64 32
AUTH_SECRET=""
# Legacy v4 alias (kept for compatibility):
NEXTAUTH_SECRET=""
# AUTH_URL / NEXTAUTH_URL are intentionally NOT set: auth.config.ts uses
# trustHost:true, so the origin is derived from each request (works on any port).
